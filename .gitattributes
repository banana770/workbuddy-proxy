# 统一换行符，避免 Windows / Unix 之间来回改动
* text=auto

# Windows 脚本保持 CRLF
*.ps1 text eol=crlf
*.vbs text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 源码与文档用 LF
*.mjs text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制
*.png binary
*.ico binary
*.exe binary
*.tgz binary
